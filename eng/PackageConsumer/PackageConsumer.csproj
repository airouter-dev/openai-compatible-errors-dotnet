<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <NuGetAudit>false</NuGetAudit>
    <ConsumerPackageVersion Condition="'$(ConsumerPackageVersion)' == ''">0.1.0</ConsumerPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AiRouter.OpenAICompatibleErrors" Version="$(ConsumerPackageVersion)" />
  </ItemGroup>
</Project>
